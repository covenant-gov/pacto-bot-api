{
  "manifest_version": "1",
  "bot_file": "greeting_bot.py",
  "bot_id": "greeting-bot",
  "registration": true,
  "shutdown": true,
  "contract_pieces": [
    {
      "name": "hello_reply",
      "type": "event_response",
      "timeout_seconds": 5,
      "inject_event": {
        "bot_id": "greeting-bot",
        "event_id": "greet-py-0001",
        "type": "dm_received",
        "chat_id": null,
        "content": "/hello",
        "rumor_id": "rumor-greet-py-0001",
        "author": "npub1sender",
        "timestamp": 1700000000000
      },
      "expect_response": {
        "event_id": "greet-py-0001",
        "action": "reply",
        "content": "Hello there! Welcome to Pacto."
      }
    },
    {
      "name": "ignore_unknown",
      "type": "event_response",
      "timeout_seconds": 5,
      "inject_event": {
        "bot_id": "greeting-bot",
        "event_id": "greet-py-0002",
        "type": "dm_received",
        "chat_id": null,
        "content": "just chatting",
        "rumor_id": "rumor-greet-py-0002",
        "author": "npub1sender",
        "timestamp": 1700000001000
      },
      "expect_response": {
        "event_id": "greet-py-0002",
        "action": "ignore"
      }
    },
    {
      "name": "reaction_reply",
      "type": "event_response",
      "timeout_seconds": 5,
      "inject_event": {
        "bot_id": "greeting-bot",
        "event_id": "greet-py-0003",
        "type": "reaction_received",
        "chat_id": "npub1sender",
        "content": "\ud83d\udc4d",
        "rumor_id": "abababababababababababababababababababababababababababababababab",
        "author": "npub1sender",
        "timestamp": 1700000002000,
        "reaction": {
          "target_rumor_id": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
          "emoji": "\ud83d\udc4d"
        }
      },
      "expect_response": {
        "event_id": "greet-py-0003",
        "action": "reply",
        "content": "Thanks for reacting \ud83d\udc4d!"
      }
    },
    {
      "name": "attachment_reply",
      "type": "event_response",
      "timeout_seconds": 5,
      "inject_event": {
        "bot_id": "greeting-bot",
        "event_id": "greet-py-0004",
        "type": "attachment_received",
        "chat_id": "npub1sender",
        "content": "https://cdn.example/file",
        "rumor_id": "efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef",
        "author": "npub1sender",
        "timestamp": 1700000003000,
        "attachment": {
          "mime_type": "text/plain",
          "size": 5,
          "filename": "notes.txt",
          "path": "/var/lib/pacto/spool/inbound/test.txt",
          "expires_at": 1700003600
        }
      },
      "expect_response": {
        "event_id": "greet-py-0004",
        "action": "reply",
        "content": "Received notes.txt."
      }
    }
  ]
}
